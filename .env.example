# ---------------------------------------------------------------- LLM backend
# "openai"    -> any OpenAI-compatible server (vLLM, TGI, llama.cpp, Ollama)
# "anthropic" -> Claude API
LLM_PROVIDER=openai

# --- Claude API (LLM_PROVIDER=anthropic)
# Leave unset to use ANTHROPIC_API_KEY from the environment or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Retry on a `refusal` stop_reason with a sibling model. Cyber-security corpora
# occasionally trip the safety classifier on legitimate defensive questions.
ANTHROPIC_FALLBACKS=true

# --- OpenAI-compatible (LLM_PROVIDER=openai)
# Start a server first, e.g.:
#   vllm serve Qwen/Qwen3-8B --port 8000 --tensor-parallel-size 2 \
#              --max-model-len 32768 --guided-decoding-backend xgrammar
OPENAI_BASE_URL=http://0.0.0.0:8000/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=QuixiAI/Qwen3-30B-A3B-AWQ

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=300

# -------------------------------------------------------------------- Logging
# File logs are INFO-level; -v also shows them in terminal. Disable sensitive payloads as needed.
LOG_PAYLOADS=true
LOG_MAX_CHARS=4000
LOG_FILE=logs/cyber-rag.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------------ Embedding
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda                 # cuda | cuda:1 | cpu
EMBEDDING_BATCH_SIZE=8

# ------------------------------------------------------------------- Chunking
CHUNK_SIZE=700              # tokens
CHUNK_OVERLAP=120

# -------------------------------------------------------------------- Docling
# TableFormer ACCURATE preserves complex table structure better. Turn OCR on
# only for scanned/image-only PDFs; it makes ingestion significantly slower.
DOCLING_TABLE_MODE=accurate  # accurate | fast
DOCLING_DO_OCR=false
MARKDOWN_DIR=data/processed/markdown

# ------------------------------------------------------------------ Retrieval
TOP_K_DENSE=30
TOP_K_SPARSE=30
TOP_K_FUSED=20
TOP_K_RERANK=6
RERANK_SCORE_THRESHOLD=0.0

# ----------------------------------------------------------------- Agent loop
MAX_RETRIEVAL_ROUNDS=3
MIN_SUPPORTING_CHUNKS=2

# --------------------------------------------------------------------- Qdrant
COLLECTION=cyber_docs
